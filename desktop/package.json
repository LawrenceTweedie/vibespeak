{
  "name": "vibespeak-desktop",
  "version": "1.0.0",
  "description": "VibeSpeak Desktop Application",
  "main": "main.js",
  "homepage": "https://github.com/vibespeak/vibespeak",
  "author": {
    "name": "VibeSpeak Team",
    "email": "support@vibespeak.com"
  },
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.vibespeak.app",
    "productName": "VibeSpeak",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "app/client/dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Network",
      "maintainer": "VibeSpeak Team <support@vibespeak.com>",
      "vendor": "VibeSpeak",
      "synopsis": "Real-time video communication platform"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  }
}
